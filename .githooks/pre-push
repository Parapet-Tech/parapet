#!/bin/sh
# Blocks any push whose outgoing commits fail public hygiene
# (identity, tool trailers, home-directory paths).
# Activate once per clone: git config core.hooksPath .githooks

remote="$1"
zero=0000000000000000000000000000000000000000
status=0

while read -r local_ref local_sha remote_ref remote_sha; do
    [ "$local_sha" = "$zero" ] && continue  # deleting a ref
    if [ "$remote_sha" = "$zero" ]; then
        range="$local_sha --not --remotes=$remote"
    else
        range="$remote_sha..$local_sha"
    fi
    # shellcheck disable=SC2086
    python3 "$(git rev-parse --show-toplevel)/scripts/check_public_hygiene.py" $range || status=1
    case "$local_ref" in
    refs/tags/*)
        python3 "$(git rev-parse --show-toplevel)/scripts/check_public_hygiene.py" --tag-object "$local_sha" || status=1
        ;;
    esac
done

exit $status
